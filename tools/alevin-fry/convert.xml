<tool id="alevin_fry_convert" name="alevin-fry convert" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" python_template_version="3.5" profile="@PROFILE_VERSION@">
    <description>BAM/SAM to RAD</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="requirements"/>
    <command detect_errors="exit_code"><![CDATA[
        ln -s '$input' input.bam &&
        alevin-fry convert --bam input.bam --output map.rad
        #if $filter_best:
            --filter_best
        #end if
        &&
        mv map.rad $output_rad
    ]]></command>
    <inputs>
        <param name="input" type="data" format="bam,sam" label="BAM or SAM file"/>
        <param argument="--filter_best" type="boolean" checked="false" label="filter best" help="Keep only the highest scoring alignments for each read"/>
    </inputs>
    <outputs>
        <data name="output_rad" format="rad" label="${tool.name} on ${on_string}"/>
    </outputs>
    <tests>
        <test>
            <param name="input" value="convert/input.bam"/>
            <output name="output_rad">
                <assert_contents>
                    <has_size value="516" delta="0"/>
                </assert_contents>
            </output>
        </test>
    </tests>
    <help><![CDATA[
        help
    ]]></help>
    <expand macro="citations"/>
</tool>
