<tool id="alevin_fry_collate" name="Alevin-Fry Collate" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" python_template_version="3.5" profile="@PROFILE_VERSION@">
    <description>a RAD file by corrected cell barcode</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="requirements"/>
    <command detect_errors="exit_code"><![CDATA[
        cp -r '$input_permit_list.extra_files_path/$input_permit_list.metadata.store_root/permit_list' input_permit_list &&
        mkdir input_rad &&
        ln -s '$input_rad' input_rad/map.rad &&
        alevin-fry collate --input-dir input_permit_list --rad-dir input_rad
        #if $collation_mode == 'two_round':
            --collation-mode two-round
        #else if $collation_mode == 'fast':
            --collation-mode fast
        #end if
        &&
        mv input_permit_list/map.collated.rad $output_rad &&
        mv input_permit_list/collate.json $output_json &&
        mv input_permit_list/unmapped_bc_count_collated.bin $output_bin
    ]]></command>
    <inputs>
        <param type="data" name="input_permit_list" label="Output of 'Alevin-Fry Generate Permit List'" format="directory"/>
        <param type="data" name="input_rad" label="RAD file to be collated" format="rad"/>
        <param name="collation_mode" type="select" label="Collation mode for multi-barcode data">
            <option value="two_round" selected="true">two-round (generalizable)</option>
            <option value="fast">fast (single-pass for 2-level)</option>
        </param>
    </inputs>
    <outputs>
        <data name="output_rad" label="${tool.name} on ${on_string}: '$input_rad'.collated" format="rad"/>
        <data name="output_json" label="${tool.name} on ${on_string}: collate" format="json"/>
        <!-- not sure if bin output is always given -->
        <data name="output_bin" label="${tool.name} on ${on_string}: bin" format="bin"/>
    </outputs>
    <tests>
    <test expect_num_outputs="3">
        <param name="input_permit_list" value="permit_list"/>
        <param name="input_rad" value="map.rad"/>
        <param name="collation_mode" value="two_round"/>
        <output name="output_rad">
            <assert_contents>
                <has_size value="108445" delta="0"/>
            </assert_contents>
        </output>
        <output name="output_json">
            <assert_contents>
                <has_size value="127" delta="100"/>
            </assert_contents>
        </output>
        <output name="output_bin">
            <assert_contents>
                <has_size value="3" delta="0"/>
            </assert_contents>
        </output>
    </test>
    </tests>
    help
    <help>
        help
    </help>
    <expand macro="citations"/>
</tool>
