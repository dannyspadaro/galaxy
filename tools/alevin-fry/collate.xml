<tool id="alevin_fry_collate" name="Alevin-Fry Collate" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" python_template_version="3.5" profile="@PROFILE_VERSION@">
    <description>a RAD file by corrected cell barcode</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="requirements"/>
    <command detect_errors="exit_code"><![CDATA[
        cp -r '$input_permit_list.extra_files_path/$input_permit_list.metadata.store_root/permit_list' permit_list &&
        mkdir input_rad &&
        ln -s '$input_rad' input_rad/map.rad &&
        alevin-fry collate --input-dir permit_list --rad-dir input_rad
        #if $collation_mode == 'two_round':
            --collation-mode two-round
        #else if $collation_mode == 'fast':
            --collation-mode fast
        #end if
        &&
        mkdir -p '$output_collated_dir.extra_files_path/collated_permit_list' &&
        mv permit_list/* '$output_collated_dir.extra_files_path/collated_permit_list' &&
        touch '$output_collated_dir'
    ]]></command>
    <inputs>
        <param name="input_permit_list" type="data" format="directory" label="Output of 'Alevin-Fry Generate Permit List'"/>
        <param name="input_rad" type="data" format="rad" label="RAD file to be collated"/>
        <param name="collation_mode" type="select" label="Collation mode for multi-barcode data">
            <option value="two_round" selected="true">two-round (generalizable)</option>
            <option value="fast">fast (single-pass for 2-level)</option>
        </param>
    </inputs>
    <outputs>
        <data name="output_collated_dir" format="directory" label="${tool.name} on ${on_string}: collated permit list"/>
    </outputs>
    <tests>
    <test expect_num_outputs="1">
        <param name="input_permit_list" value="permit_list"/>
        <param name="input_rad" value="input_rad/map.rad"/>
        <param name="collation_mode" value="two_round"/>
        <output name="output_collated_dir">
            <extra_files type="directory" value="collated_permit_list/all_freq.bin"/>
            <extra_files type="directory" value="collated_permit_list/collate.json"/>
            <extra_files type="directory" value="collated_permit_list/generate_permit_list.json"/>
            <extra_files type="directory" value="collated_permit_list/map.collated.rad"/>
            <extra_files type="directory" value="collated_permit_list/permit_freq.bin"/>
            <extra_files type="directory" value="collated_permit_list/permit_map.bin"/>
            <extra_files type="directory" value="collated_permit_list/unmapped_bc_count_collated.bin"/>
        </output>
    </test>
    </tests>
    <help>
        help
    </help>
    <expand macro="citations"/>
</tool>
