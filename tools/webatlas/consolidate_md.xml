<tool id="webatlas_consolidate_md" name="Webatlas Consolidate Metadata" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" python_template_version="3.5" profile="@PROFILE_VERSION@">
    <description>TODO description</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <requirements>
        <requirement type="package" version="0.5.0">fire</requirement>
        <requirement type="package" version="2.16.1">zarr</requirement>
        <!-- pinning python to version <3.13 is necessary because otherwise fire can not import pipes -->
        <requirement type="package" version="3.10">python</requirement>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
        ln -s '$input_zarr.extra_files_path/$input_zarr.metadata.store_root' output.zarr &&
        python "${__tool_directory__}/consolidate_md.py" --file_in output.zarr &&
        zip -r output.zarr.zip output.zarr &&
        mv output.zarr.zip $output_zarr
    ]]></command>
    <inputs>
        <param name="input_zarr" type="data" format="zarr" label="zarr file"/>
    </inputs>
    <outputs>
        <data name="output_zarr" format="zarr.zip" label="${tool.name} on ${on_string}: zarr output"/>
    </outputs>
    <tests>
        <!-- Hint: You can use [ctrl+alt+t] after defining the inputs/outputs to auto-scaffold some basic test cases. -->
    </tests>
